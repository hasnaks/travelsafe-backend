{
  "info": {
    "name": "Backend Member 1 API Suite - Safety & Guardian Services",
    "description": "API collection for Authentication, Silent Duress PIN, User Medical Profile, and Guardian Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & PIN Security",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Vance\",\n  \"email\": \"sarah@example.com\",\n  \"phone\": \"+15552345678\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/register" }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/login" }
          }
        },
        {
          "name": "Verify PIN (Standard Code: 1234)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"1234\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/verify-pin" }
          }
        },
        {
          "name": "Verify PIN (Silent Duress Code: 9999)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"9999\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/verify-pin" }
          }
        }
      ]
    },
    {
      "name": "User & ICE Medical Profile",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/v1/profile" }
          }
        },
        {
          "name": "Update ICE Medical Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodGroup\": \"O+\",\n  \"allergies\": [\"Penicillin\", \"Aspirin\"],\n  \"conditions\": [\"Asthma\"]\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/profile/medical" }
          }
        },
        {
          "name": "Get Safe Places (Geofence)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/v1/profile/safe-places" }
          }
        },
        {
          "name": "Add Safe Place",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Home\",\n  \"address\": \"124 Elm Street\",\n  \"latitude\": 37.7749,\n  \"longitude\": -122.4194,\n  \"radiusMeters\": 100\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/profile/safe-places" }
          }
        }
      ]
    },
    {
      "name": "Guardian Management",
      "item": [
        {
          "name": "Get Guardians List",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/v1/guardians" }
          }
        },
        {
          "name": "Generate Guardian Invite Code",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:5000/api/v1/guardians/invite" }
          }
        },
        {
          "name": "Accept Guardian Invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"GRD-884120\",\n  \"guardianName\": \"Alex Smith\",\n  \"phone\": \"+15559990000\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/guardians/accept-invite" }
          }
        }
      ]
    }
  ]
}
